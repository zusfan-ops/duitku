{
  "manifest_version": 3,
  "name": "DuitKu - Catat Keuangan & Akses Cepat",
  "version": "1.0.0",
  "description": "Ekstensi resmi DuitKu untuk cek saldo, ringkasan pengeluaran, catat transaksi cepat, dan pintasan langsung ke dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DuitKu - Catat Keuangan",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
